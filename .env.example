APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=si_presensi_untad
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SIGA8 SSO ---
# SIGA8_LOGIN_URL=https://siga8.untad.ac.id/api/login
SIGA8_LOGIN_URL=http://127.0.0.1:8001/api/mock/siga8/login
SIGA8_TIMEOUT=8
SIGA8_CONNECT_TIMEOUT=3
SIGA8_RETRY_TIMES=1
SIGA8_RETRY_DELAY_MS=300

# --- Face recognition microservice (Python/FastAPI, PRD 8.3) ---
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SIMILARITY_THRESHOLD=0.45
FACE_SERVICE_TIMEOUT=15
FACE_SERVICE_CONNECT_TIMEOUT=5
FACE_EMBEDDING_DIM=512
FACE_ENROLL_PHOTOS_FIELD=photo
FACE_VERIFY_PHOTO_FIELD=photo
FACE_VERIFY_EMBEDDINGS_FIELD=candidates
FACE_VERIFY_THRESHOLD_FIELD=threshold
FACE_LIVENESS_REQUIRED=true
FACE_ENROLL_REQUIRE_QUALITY=true
FACE_ENROLL_MIN_QUALITY=0.65
FACE_ENROLL_REQUIRE_SINGLE_FACE=true
FACE_ENROLL_MIN_SAMPLES=5
FACE_ENROLL_REQUIRED_POSES=

# --- Google Calendar service account ---
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_CREDENTIALS_PATH=google-calendar-service-account.json
GOOGLE_CALENDAR_DEFAULT_ID=
GOOGLE_CALENDAR_HOLIDAY_ID=
GOOGLE_CALENDAR_LEAVE_ID=
GOOGLE_CALENDAR_TIMEZONE=Asia/Makassar
GOOGLE_CALENDAR_TIMEOUT=15
GOOGLE_CALENDAR_CONNECT_TIMEOUT=5
GOOGLE_CALENDAR_TOKEN_CACHE_SECONDS=3300
