# FastAPI / Uvicorn
APP_ENV=local
HOST=0.0.0.0
PORT=8001
RELOAD=true
LOG_LEVEL=info

# Face recognition
# InsightFace downloads buffalo_l to the user cache on first run.
FACE_MODEL_NAME=buffalo_l
FACE_DET_SIZE=640

# Liveness / anti-spoofing
LIVENESS_MODEL_PATH=models/AntiSpoofing_bin_1.5_128.onnx
LIVENESS_THRESHOLD=0.50

# Optional internal API protection, if implemented later.
FACE_SERVICE_API_KEY=
